{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python .agents/hooks/test_repair.py before --adapter cursor",
        "matcher": "Shell",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python .agents/hooks/test_repair.py after --adapter cursor",
        "matcher": "Shell",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python .agents/hooks/test_repair.py after --adapter cursor",
        "matcher": "Shell",
        "timeout": 10
      }
    ]
  }
}
